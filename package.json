{
  "name": "shearim",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun run --filter '@shearim/server' --filter '@shearim/web' dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '@shearim/web' build",
    "start": "bun apps/server/src/main.ts serve",
    "lint": "biome check .",
    "e2e": "bun run build && bun run --filter '@shearim/e2e' e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "7.0.2"
  }
}
